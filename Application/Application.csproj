<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
    <Title>BnbLootHelper</Title>
    <Description>Bunkers and Badasses Loot Generator</Description>
    <Version>1.5.0</Version>
    <PackageId>Application</PackageId>
    <ElectronPackageId>com.bnbloothelper.app</ElectronPackageId>
    <ElectronSingleInstance>false</ElectronSingleInstance>
    <Copyright>Copyright 2026</Copyright>
  </PropertyGroup>
  <PropertyGroup>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Business\Business.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Models\Models.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Blazor.ContextMenu" Version="2.1.0" />
    <PackageReference Include="ElectronNET.Core" Version="0.6.0" />
    <PackageReference Include="ElectronNET.Core.AspNet" Version="0.6.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.AzureAppServices" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\Configuration\*.json">
      <Link>Configuration\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="npm run install-build" WorkingDirectory="js" />
  </Target>
</Project>